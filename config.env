#!/usr/bin/env bash
# ==============================================================
# BBGHOST — config.env
# Ajuste esses valores para o seu ambiente antes de usar.
# ==============================================================

# Interface de rede física (a que sai para a internet)
IFACE="eth0"                      # confira com `ip route | grep default`

# VPN — QUALQUER provedor (WireGuard ou OpenVPN). Não é preso a nenhum
# serviço: basta instalar o .conf (Mullvad, IVPN, ProtonVPN, Windscribe,
# AirVPN, um WireGuard próprio, etc.). O VPN_PROVIDER é só um rótulo seu.
VPN_PROVIDER="custom"              # rótulo livre (mullvad, ivpn, proton, custom...)
VPN_TYPE="wireguard"               # wireguard | openvpn
WG_INTERFACE="wg0"                 # nome usado por /etc/wireguard/<nome>.conf
OVPN_CONFIG="/etc/openvpn/client/provider.ovpn"   # só usado se VPN_TYPE=openvpn

# Multi-hop (VPN sobre VPN): quando "true", sobe um 2º túnel
# (HOP2_WG_INTERFACE) POR DENTRO do primeiro — seu IP real nunca toca
# o 2º provedor, e o 2º provedor nunca vê o 1º. Exige um .conf de 2º
# salto instalado em /etc/wireguard/<HOP2_WG_INTERFACE>.conf (só
# WireGuard). Deixe false pra um único salto.
VPN_MULTIHOP="false"
HOP2_WG_INTERFACE="wg1"

# Tor / proxychains (opcional, camada extra sobre a VPN)
USE_TOR="true"
TOR_SOCKS_PORT="9050"

# DNS seguro (evita DNS leak). O vpn.sh remove automaticamente
# qualquer diretiva "DNS =" do arquivo do WireGuard — quem manda
# no DNS é sempre o dns.sh, nunca o wg-quick/resolvconf. Use o DNS
# que vinha no .conf do SEU provedor (o instalador extrai sozinho).
SECURE_DNS="10.2.0.1"

# Desabilita IPv6 durante a sessão (evita vazamento por IPv6 fora
# do túnel, e evita o erro clássico do wg-quick tentando atribuir
# endereço IPv6 quando o sistema não suporta). Restaurado no "off".
DISABLE_IPV6="true"

# Timezone "de trabalho" (spoofed) vs real
SPOOF_TIMEZONE="true"
FAKE_TZ="Etc/UTC"

# Hostname temporário durante sessão ON — gerado em bash puro
# (sem pipes) para nunca sofrer SIGPIPE sob 'set -o pipefail'.
FAKE_HOSTNAME="ws-$(printf '%04x%04x' $RANDOM $RANDOM)"

# Diretórios — BBGHOST_HOME já é definido pelo opsec.sh (baseado
# em onde o script está) e EXPORTADO para os módulos filhos.
# NÃO redeclare aqui, isso sobrescreveria o valor correto.
LOCK_FILE="$BBGHOST_HOME/status.lock"
LOG_FILE="$BBGHOST_HOME/opsec.log"
WORKSPACE_EPHEMERAL="$HOME/.bbghost_workspace"
STATE_DIR="$BBGHOST_HOME/.state"      # baselines: MAC real, hostname real, gateway MAC etc.

# Log em RAM (item OPSEC): com "true", o log vai pra /dev/shm (tmpfs)
# e some no desligamento da máquina — não deixa um diário forense
# persistente das suas sessões no disco. Com "false", fica no projeto
# (útil pra depurar, mas é um artefato de apreensão). Em qualquer
# modo, valores sensíveis (MAC real, hostname real, MAC do gateway)
# NÃO são mais escritos no log — só a confirmação de que a etapa deu
# certo. Os valores reais ficam só em $STATE_DIR (chmod 700).
LOG_TO_RAM="false"
if [[ "${LOG_TO_RAM:-false}" == "true" ]]; then
    LOG_FILE="/dev/shm/.bbghost-$(id -u 2>/dev/null || echo 0).log"
fi
# Garante que o arquivo de log nasce 600 (dono só) — tanto no disco
# quanto no tmpfs, onde o padrão seria legível por outros usuários.
( umask 077; : >> "$LOG_FILE" ) 2>/dev/null || true
chmod 600 "$LOG_FILE" 2>/dev/null || true

# Portas que você ESPERA ver escutando localmente (baseline do
# radar). Qualquer porta nova que aparecer depois disso é sinalizada.
# Formato: separadas por espaço. Ajuste pro seu ambiente normal.
EXPECTED_LISTEN_PORTS="22 631"

# Reação automática do radar a sinais fortes de ataque (ARP spoof
# confirmado / modo promíscuo detectado). Quando true, o radar não
# só AVISA — ele aciona o panic.sh sozinho: corta a interface física
# na hora. Desative se estiver numa rede instável onde o gateway
# muda de MAC com frequência por motivo legítimo (evita pânico falso).
RADAR_AUTO_REACT="true"

# Dead man's switch do radar. Quando ativado, o radar espera algum
# toque de tecla seu a cada ciclo como "check-in de presença". Se
# passar mais que DEADMAN_TIMEOUT_SEC sem nenhuma tecla, aciona o
# panic.sh sozinho — pensado pro cenário de você ser afastado da
# máquina (fisicamente detido, dispositivo apreendido, etc.) no meio
# de uma sessão ativa. Desligado por padrão: ligar isso muda o
# comportamento do radar de forma real, então é opt-in.
DEADMAN_ENABLED="false"
DEADMAN_TIMEOUT_SEC="900"

# Browser isolado para contas sensíveis (e-mail, etc.)
FIREFOX_SENSITIVE_PROFILE="bbghost-proton"

# Intervalo padrão (segundos) do painel de monitoramento em tempo real
RADAR_REFRESH="5"

# A cada quantos ciclos do radar ele reconsulta IP público/geo externo
# (evita ficar batendo numa API de geolocalização toda hora — isso
# também é uma forma de "vazamento" de padrão de tráfego).
RADAR_EXTERNAL_CHECK_EVERY="6"

# ==============================================================
# OPSEC hardening v2 — novas opções
# ==============================================================

# MAC spoof: modo do macchanger.
#   "-a" = MAC aleatório mas com OUI de um fabricante REAL e plausível
#          (mistura-se melhor; um OUI totalmente aleatório às vezes é
#          mais anômalo e logável como suspeito numa rede corporativa).
#   "-r" = totalmente aleatório (comportamento antigo).
MACCHANGER_MODE="-a"

# Fixa o MAC spoofed no NetworkManager pra ele não reverter pro MAC
# real na próxima renovação de conexão. Opt-in porque modificar a
# conexão pode fazer o NM dar um "bounce" (reconectar) na interface.
NM_PIN_MAC="false"

# Silenciamento de LAN (item OPSEC): durante a sessão, cala os canais
# que anunciam o nome/identidade da máquina na rede local mesmo com a
# VPN de pé — mDNS/Avahi, LLMNR e NetBIOS. Restaurado no "off".
SILENCE_LAN="true"

# Detecção de vazamento no radar: substring (case-insensitive) que
# você ESPERA ver no "org/ASN" do seu IP público quando o tráfego está
# saindo mesmo pela VPN (ex: "Mullvad", "Proton", "M247", "DataCamp"). Se o org
# do IP público não bater com isso, o radar grita LEAK. Vazio desliga
# a checagem. Confira o valor certo rodando 'opsec.sh radar' uma vez
# com a VPN de pé e vendo qual org aparece.
VPN_EXPECT_ORG="Proton"

# Reação automática do radar a vazamento confirmado (org do IP público
# não é o da VPN). Opt-in, mesma filosofia do RADAR_AUTO_REACT: quando
# "true", um leak detectado aciona o panic.sh sozinho.
RADAR_LEAK_AUTOREACT="false"

# ==============================================================
# Modo gráfico (opsec.sh gui) — interface nativa (Tkinter)
# ==============================================================
# A GUI é uma janela nativa própria (gui/bbghost_gui.py), não mais um
# painel em navegador. O perfil abaixo é o navegador Tor DEDICADO que
# o botão "Navegador Tor" da GUI abre — roteado pelo Tor, com anti-leak
# e tema Opera-GX. Separado do FIREFOX_SENSITIVE_PROFILE (só-VPN, pra
# ProtonMail) de propósito: aqui tudo sai pelo Tor.
FIREFOX_GX_PROFILE="bbghost-gx"

# ==============================================================
# Isolamento forte (opsec.sh gui → navegador / apps isolados)
# ==============================================================
# ISOLATION_MODE controla como o navegador/apps sensíveis saem:
#   none    - normal (tudo pela cadeia VPN/kill-switch do host)
#   whonix  - força TODO o tráfego por um Whonix-Gateway (ou qualquer
#             VM gateway) no IP WHONIX_GATEWAY_IP. À prova de leak mesmo
#             se o app ignorar proxy: o app roda num netns cujo ÚNICO
#             caminho de saída é o gateway. Requer a VM gateway de pé.
ISOLATION_MODE="none"
WHONIX_GATEWAY_IP="10.152.152.10"   # IP padrão do Whonix-Gateway
ISOLATION_UPLINK_IF=""               # interface/bridge do host que alcança o gateway (ex: virbr1)
ISOLATION_NS_IP="10.152.152.50"      # IP da "workstation" isolada na rede do gateway

# ==============================================================
# Automação / boot
# ==============================================================
# Com AUTOSTART_ON_BOOT="true" + 'opsec.sh autostart enable', o systemd
# sobe a cadeia OPSEC já no boot (fail-closed desde o primeiro pacote).
AUTOSTART_ON_BOOT="false"
